# search-service config. Copy to .env (gitignored) and fill in.

# Port the HTTP server binds (Fly maps 8080->this; keep 8088 locally).
PORT=8088

# RECEIVE-ONLY NWC connection string for the dedicated service sub-wallet.
# make_invoice + lookup_invoice scope ONLY. Never a spend-capable connection.
# (See vend-wallet-setup.md for how to provision a clean receive sub-wallet.)
RECEIVE_NWC_CONNECTION_STRING=nostr+walletconnect://<wallet-pubkey>?relay=wss://relay.getalby.com&secret=<secret>

# Base URL of a self-hosted SearXNG with the JSON API enabled
# (settings.yml -> search.formats: [html, json]).
SEARXNG_URL=http://localhost:8080

# Flat price per search, in sats.
PRICE_SATS=50

# 32+ random bytes for signing L402 macaroons. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MACAROON_SECRET=<32-random-bytes-hex>

# How long a minted invoice/macaroon stays valid (seconds).
MACAROON_TTL_SECONDS=900

# Optional public URL for the landing page.
# PUBLIC_URL=https://search.llmops.pro
